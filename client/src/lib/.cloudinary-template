export const CLOUDINARY_API_KEY = "YOUR-API-KEY";
export const CLOUDINARY_API_SECRET = "YOUR-API-SECRET";
export const CLOUDINARY_CLOUD_NAME = "YOUR-CLOUD-NAME";

export async function uploadImageToCloudinary(
  file: File,
  cloudName: string = CLOUDINARY_CLOUD_NAME,
  onProgress?: (progress: number) => void
): Promise<{ url: string, publicId: string, resourceType: string }> {
  const timestamp = Math.round(new Date().getTime() / 1000);

  // Extract filename without extension to use as public_id (fallback to timestamp)
  const lastDotIndex = file.name.lastIndexOf('.');
  let publicId = lastDotIndex !== -1 ? file.name.substring(0, lastDotIndex) : file.name;

  // Clean up public_id (Cloudinary doesn't like certain characters like spaces or forward slashes)
  publicId = publicId.replace(/[^a-zA-Z0-9_-]/g, '_') || `upload_${timestamp}`;

  // Add a unique suffix to prevent overwriting files with the exact same name
  publicId = `${publicId}_${Math.random().toString(36).substring(2, 8)}`;

  // Create signature using Web Crypto API. Parameters must be in alphabetical order.
  const paramsToSign = `public_id=${publicId}&timestamp=${timestamp}${CLOUDINARY_API_SECRET}`;
  const encoder = new TextEncoder();
  const data = encoder.encode(paramsToSign);
  const hashBuffer = await crypto.subtle.digest("SHA-1", data);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  const signature = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');

  const formData = new FormData();
  formData.append("file", file);
  formData.append("api_key", CLOUDINARY_API_KEY);
  formData.append("public_id", publicId);
  formData.append("timestamp", timestamp.toString());
  formData.append("signature", signature);

  return new Promise((resolve, reject) => {
    const xhr = new XMLHttpRequest();
    const url = `https://api.cloudinary.com/v1_1/${cloudName}/auto/upload`;

    xhr.open("POST", url, true);

    xhr.upload.onprogress = (event) => {
      if (event.lengthComputable && onProgress) {
        const progress = Math.round((event.loaded * 100) / event.total);
        onProgress(progress);
      }
    };

    xhr.onload = () => {
      if (xhr.status >= 200 && xhr.status < 300) {
        try {
          const dataResult = JSON.parse(xhr.responseText);
          resolve({
            url: dataResult.secure_url,
            publicId: dataResult.public_id,
            resourceType: dataResult.resource_type
          });
        } catch (e) {
          reject(new Error("Failed to parse Cloudinary response"));
        }
      } else {
        let errorMessage = "Failed to upload image";
        try {
          const errorData = JSON.parse(xhr.responseText);
          if (errorData.error?.message) {
            errorMessage = errorData.error.message;
          }
        } catch (e) {
          // Ignored
        }
        reject(new Error(errorMessage));
      }
    };

    xhr.onerror = () => {
      reject(new Error("Network error during upload"));
    };

    xhr.send(formData);
  });
}

export async function deleteImageFromCloudinary(publicId: string, resourceType: string, cloudName: string = CLOUDINARY_CLOUD_NAME): Promise<void> {
  const timestamp = Math.round(new Date().getTime() / 1000);

  // Create signature
  const paramsToSign = `public_id=${publicId}&timestamp=${timestamp}${CLOUDINARY_API_SECRET}`;
  const encoder = new TextEncoder();
  const data = encoder.encode(paramsToSign);
  const hashBuffer = await crypto.subtle.digest("SHA-1", data);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  const signature = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');

  const formData = new FormData();
  formData.append("api_key", CLOUDINARY_API_KEY);
  formData.append("public_id", publicId);
  formData.append("timestamp", timestamp.toString());
  formData.append("signature", signature);

  const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/${resourceType}/destroy`, {
    method: "POST",
    body: formData
  });

  if (!response.ok) {
    console.error("Failed to delete image from Cloudinary");
  }
}
